# === Pulse environment variables ===
# Copy this file to .env and fill in the values.
# The .env file is gitignored — never commit real secrets.

# --- Postgres (metadata store) ---
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse_dev_password
POSTGRES_DB=pulse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MinIO (object storage, S3-compatible) ---
MINIO_ROOT_USER=pulse
MINIO_ROOT_PASSWORD=pulse_dev_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=pulse

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=pulse
MONGO_INITDB_ROOT_PASSWORD=pulse_dev_password
MONGO_HOST=mongodb
MONGO_PORT=27017

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Anthropic (agent provider) ---
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-ME
PULSE_AGENT_PROVIDER=anthropic   # or "mock" for free-tier fallback
PULSE_AGENT_MODEL=claude-haiku-4-5-20251001

# --- App ---
PULSE_ENV=development
PULSE_LOG_LEVEL=INFO
